<Window x:Class="GorapaduckPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="470" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseWheel="Window_MouseWheel" Closing="Window_Closing">
  <Window.ContextMenu>
    <ContextMenu FontFamily="Malgun Gothic" FontSize="14">
      <MenuItem Header="🍚 밥 주기" Click="Feed_Click"/>
      <MenuItem Header="💛 쓰다듬기" Click="Pet_Click"/>
      <MenuItem Header="⚽ 공놀이" Click="Play_Click"/>
      <MenuItem Header="💤 재우기" Click="Sleep_Click"/>
      <MenuItem Header="✨ 진화 확인" Click="Evolution_Click"/>
      <MenuItem Header="🔄 디지몬 데이터 다시 불러오기" Click="Reload_Click"/>
      <Separator/>
      <MenuItem Header="🥚 새 디지타마 추가" Click="AddPet_Click"/>
      <MenuItem x:Name="PauseMenu" Header="⏸ 돌아다니기 일시정지" Click="Pause_Click"/>
      <MenuItem Header="⚙ 설정" Click="Settings_Click"/>
      <MenuItem Header="숨기기" Click="Hide_Click"/>
      <MenuItem Header="이 펫 놓아주기" Click="RemovePet_Click"/>
      <Separator/>
      <MenuItem Header="종료" Click="Exit_Click"/>
    </ContextMenu>
  </Window.ContextMenu>

  <Grid>
    <Border x:Name="SpeechBubble" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Background="#F8FFFFFF" BorderBrush="#D9BD7A" BorderThickness="1.5"
            CornerRadius="13" Padding="12,7" Margin="8,0,8,290" Visibility="Collapsed">
      <TextBlock x:Name="SpeechText" FontFamily="Malgun Gothic" FontSize="14"
                 Foreground="#4C351D" Text="안녕!" Width="215" TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>

    <Grid x:Name="PetScaleHost" Width="250" Height="280" VerticalAlignment="Bottom"
          RenderTransformOrigin="0.5,1">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1"/>
      </Grid.RenderTransform>

    <Grid x:Name="PetVisual" RenderTransformOrigin="0.5,0.82">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="FacingTransform" ScaleX="1"/>
          <RotateTransform x:Name="WaddleTransform" Angle="0"/>
          <TranslateTransform x:Name="BobTransform" Y="0"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <Image x:Name="PetImage" Stretch="Uniform"
             RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
             Margin="22,10,22,12" Visibility="Collapsed"
             ToolTip="끌어서 옮기고, 두 번 클릭하면 쓰다듬어요!"/>
      <Grid x:Name="EggVisual" HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="145" Height="180">
        <Ellipse Stroke="#234B67" StrokeThickness="6">
          <Ellipse.Fill>
            <RadialGradientBrush GradientOrigin="0.35,0.25" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75">
              <GradientStop Color="#FFF9D7" Offset="0"/>
              <GradientStop Color="#70D8E8" Offset="0.72"/>
              <GradientStop Color="#37A3BF" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="27" Height="36" Fill="#275878" Margin="25,25,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Ellipse Width="20" Height="25" Fill="#275878" Margin="0,62,28,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <Ellipse Width="31" Height="22" Fill="#275878" Margin="38,0,0,31" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <TextBlock Text="01" FontFamily="Consolas" FontWeight="Bold" FontSize="21"
                   Foreground="#17394F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <Canvas IsHitTestVisible="False">
        <Border x:Name="FoodBowl" Width="72" Height="28" Canvas.Left="88" Canvas.Top="188"
                Background="#E83B35" BorderBrush="#75211E" BorderThickness="3"
                CornerRadius="4,4,18,18" Visibility="Collapsed">
          <TextBlock Text="● ● ●" Foreground="#8A5628" FontSize="11" HorizontalAlignment="Center"/>
        </Border>
        <Ellipse x:Name="PlayBall" Width="38" Height="38" Canvas.Left="106" Canvas.Top="174"
                 Fill="#EF4E45" Stroke="White" StrokeThickness="5" Visibility="Collapsed">
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="BallTransform"/>
          </Ellipse.RenderTransform>
        </Ellipse>
        <TextBlock x:Name="ActionEffect" Canvas.Left="94" Canvas.Top="14" FontSize="28"
                   FontWeight="Bold" Foreground="#F35D75" Text="💛" Visibility="Collapsed">
          <TextBlock.RenderTransform>
            <TranslateTransform x:Name="EffectTransform"/>
          </TextBlock.RenderTransform>
        </TextBlock>
      </Canvas>

    </Grid>
    </Grid>

    <Border x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#F5FFFFFF" BorderBrush="#2C91A8" BorderThickness="1.5"
            CornerRadius="10" Padding="14,10" Visibility="Collapsed" Panel.ZIndex="20">
      <TextBlock x:Name="LoadingText" Text="DIGIMON DATA 연결 중…" Width="230"
                 FontFamily="Malgun Gothic" FontSize="13" FontWeight="Bold"
                 Foreground="#2C6B79" TextAlignment="Center" TextWrapping="Wrap"/>
    </Border>

    <Border x:Name="StatsPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="#EEFFFFFF" BorderBrush="#8CBCCA" BorderThickness="1"
            CornerRadius="10" Padding="12,7" Margin="0,0,0,5" Opacity="0">
      <StackPanel Width="230">
        <TextBlock x:Name="PetNameText" Text="Digimon" FontWeight="Bold" FontFamily="Malgun Gothic"
                   FontSize="14" HorizontalAlignment="Center"/>
        <TextBlock x:Name="StatsText" FontFamily="Malgun Gothic" FontSize="12"
                   TextAlignment="Center" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
