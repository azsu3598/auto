<Window x:Class="GorapaduckPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="디지몬 데스크톱 펫 설정" Width="440" Height="490"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFF9F0" FontFamily="Malgun Gothic">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="내 바탕화면에 맞추기" FontSize="25" FontWeight="Bold" Foreground="#402D19"/>
      <TextBlock Text="마우스 휠은 펫만 조절하며 안내창 크기는 그대로 유지됩니다." Margin="0,6,0,22" Foreground="#76624C"/>
    </StackPanel>

    <StackPanel Grid.Row="1">
      <TextBlock Text="펫 크기" FontSize="16" FontWeight="SemiBold"/>
      <DockPanel Margin="0,4,0,18">
        <TextBlock x:Name="ScaleLabel" DockPanel.Dock="Right" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
        <Slider x:Name="ScaleSlider" Minimum="0.2" Maximum="1.35" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
      </DockPanel>
      <TextBlock Text="이동 속도" FontSize="16" FontWeight="SemiBold"/>
      <DockPanel Margin="0,4,0,18">
        <TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
        <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="5" TickFrequency="0.1" ValueChanged="Slider_ValueChanged"/>
      </DockPanel>
      <CheckBox x:Name="WanderCheck" Content="바탕화면 여기저기 돌아다니기" FontSize="15" Margin="0,8"/>
      <CheckBox x:Name="TopmostCheck" Content="다른 창 위에도 펫 표시" FontSize="15" Margin="0,8"/>
      <CheckBox x:Name="FullscreenCheck" Content="전체 화면 앱을 사용하는 동안 숨기기" FontSize="15" Margin="0,8"/>
      <Border Background="#FFFFDF9A" CornerRadius="8" Padding="12" Margin="0,20,0,0">
        <TextBlock Text="사용법: 끌어서 이동 · 두 번 클릭해서 쓰다듬기 · 마우스 휠로 크기 조절 · 오른쪽 클릭으로 행동 메뉴" TextWrapping="Wrap" LineHeight="22"/>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="취소" Width="90" IsCancel="True"/>
      <Button Content="저장" Width="90" IsDefault="True" Background="#FFFFB52E" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
