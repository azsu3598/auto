{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateNamedPaperSecretsInSeoul",
      "Effect": "Allow",
      "Action": "secretsmanager:CreateSecret",
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-2:*:secret:stock-automation-paper/kiwoom-demo-??????",
        "arn:aws:secretsmanager:ap-northeast-2:*:secret:stock-automation-paper/dart-??????",
        "arn:aws:secretsmanager:ap-northeast-2:*:secret:stock-automation-paper/telegram-??????"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "secretsmanager:Name": [
            "stock-automation-paper/kiwoom-demo",
            "stock-automation-paper/dart",
            "stock-automation-paper/telegram"
          ]
        }
      }
    },
    {
      "Sid": "DescribeAndUpdateOwnNamedPaperSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-2:*:secret:stock-automation-paper/kiwoom-demo-??????",
        "arn:aws:secretsmanager:ap-northeast-2:*:secret:stock-automation-paper/dart-??????",
        "arn:aws:secretsmanager:ap-northeast-2:*:secret:stock-automation-paper/telegram-??????"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    }
  ]
}
